msgstr "等待 CPU 采样"

msgid "Samples approximately every 10 seconds; history starts when this page opens."
msgstr "约每 10 秒采样；历史记录从打开本页开始。"

msgid "Last interval: %s s"
msgstr "最近采样间隔：%s 秒"

msgid "Hardware sample unavailable"
msgstr "硬件采样不可用"

msgid "Counter / interval change"
msgstr "寄存器累计值 / 本间隔增量"

