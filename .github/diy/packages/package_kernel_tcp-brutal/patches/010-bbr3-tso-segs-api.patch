From: lunatickochiya <125438787@qq.com>
Subject: [PATCH] brutal: support the BBRv3 TSO sizing API

The BBRv3 backport replaces tcp_congestion_ops.min_tso_segs with the
two-argument tso_segs callback. Keep the reservation side effect in the
existing callback and reproduce tcp_tso_autosize() when the BBRv3 API is
present, so TCP Brutal retains its previous TSO sizing behaviour.

Use TCP_CONG_WANTS_CE_EVENTS as the feature test because it is introduced
immediately before the TSO API change by the same BBRv3 preparation series.

Signed-off-by: lunatickochiya <125438787@qq.com>
---
 brutal_cc.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

--- a/brutal_cc.c
+++ b/brutal_cc.c
@@ -138,6 +138,26 @@ static u32 brutal_min_tso_segs(struct so
     return 2;
 }
 
+#ifdef TCP_CONG_WANTS_CE_EVENTS
+static u32 brutal_tso_segs(struct sock *sk, unsigned int mss_now)
+{
+    unsigned long bytes;
+    u32 min_tso_segs, r;
+
+    min_tso_segs = brutal_min_tso_segs(sk);
+    bytes = READ_ONCE(sk->sk_pacing_rate) >> READ_ONCE(sk->sk_pacing_shift);
+
+    r = tcp_min_rtt(tcp_sk(sk)) >>
+        READ_ONCE(sock_net(sk)->ipv4.sysctl_tcp_tso_rtt_log);
+    if (r < BITS_PER_TYPE(sk->sk_gso_max_size))
+        bytes += sk->sk_gso_max_size >> r;
+
+    bytes = min_t(unsigned long, bytes, sk->sk_gso_max_size);
+
+    return max_t(u32, bytes / mss_now, min_tso_segs);
+}
+#endif
+
 static void brutal_init(struct sock *sk)
 {
     struct tcp_sock *tp = tcp_sk(sk);
@@ -233,7 +252,11 @@ struct tcp_congestion_ops tcp_brutal_ops
     .cong_control = brutal_main,
     .undo_cwnd = brutal_undo_cwnd,
     .ssthresh = brutal_ssthresh,
+#ifdef TCP_CONG_WANTS_CE_EVENTS
+    .tso_segs = brutal_tso_segs,
+#else
     .min_tso_segs = brutal_min_tso_segs,
+#endif
 };
 
 static int __init brutal_register(void)
